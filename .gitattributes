# Normalize text files while keeping platform-specific scripts correct.
* text=auto

*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.sh text eol=lf
gradlew text eol=lf
*.bat text eol=crlf

# Binary artifacts and assets.
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.apk binary
*.aab binary
*.jks binary
*.keystore binary
